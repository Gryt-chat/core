{
  "name": "@gryt/core",
  "version": "0.18.2",
  "description": "Gryt's shared application logic: one implementation of the things the desktop and mobile apps both do.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gryt-chat/core.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node scripts/add-esm-extensions.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "test:comment-length": "node scripts/check-comment-length.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "check-surface": "node scripts/check-public-surface.ts",
    "prepublishOnly": "npm run build && npm run test && npm run check-surface"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.33",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@gryt/crypto": "0.11.1",
    "@noble/hashes": "^2.3.0"
  }
}
