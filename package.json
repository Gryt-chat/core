{
  "name": "@gryt/core",
  "version": "0.5.0",
  "description": "Gryt's shared application logic: one implementation of the things the desktop and mobile apps both do.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gryt-chat/core.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node scripts/add-esm-extensions.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "check-surface": "node scripts/check-public-surface.mjs",
    "prepublishOnly": "npm run build && npm run test && npm run check-surface"
  },
  "devDependencies": {
    "@types/node": "^20.19.33",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
